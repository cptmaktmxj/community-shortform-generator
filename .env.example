# Optional override for the HTTP client identity.
# COMMUNITY_USER_AGENT=community-shortform-generator/0.1 (contact: you@example.com)

# API key for an OpenAI-compatible endpoint. Ollama can use the config default.
# CURATION_LLM_API_KEY=replace-with-provider-key

# Required only when a Reddit source is enabled.
# REDDIT_ACCESS_TOKEN=replace-with-reddit-token
